# Git stores LF whatever a worker's core.autocrlf is (commonroom#513). Binary files are detected and left alone.
* text=auto eol=lf

# Prompt fixtures are compared byte for byte (commonroom#216): never convert their line endings.
tests/golden_prompts/*.txt -text
# The prompt templates stay LF in every checkout, whatever core.autocrlf says (commonroom#216).
commonroom/ways/prompts/*.md text eol=lf
# So does the ways-of-working table (commonroom#217).
commonroom/ways/policy.toml text eol=lf
