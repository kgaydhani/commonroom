{
  "description": "Common Room: point a session at its project's room folder (commonroom#262). Adds context only (session start; a cold return to a large context, #367). Runs hooks/run.py, which finds the room's code beside the plugin or at the path in the room home's room-path file (#565).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.py", "session-start"],
            "commandWindows": "if exist \"%PLUGIN_ROOT%\\hooks\\run.py\" python \"%PLUGIN_ROOT%\\hooks\\run.py\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.py", "prompt-submit"],
            "commandWindows": "if exist \"%PLUGIN_ROOT%\\hooks\\run.py\" python \"%PLUGIN_ROOT%\\hooks\\run.py\" prompt-submit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
