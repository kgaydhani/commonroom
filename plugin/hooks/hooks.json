{
  "description": "Common Room: point a session at its project's room folder (commonroom#262). Adds context only (session start; a cold return to a large context, #367).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/../room.py", "hook", "session-start"],
            "commandWindows": "if exist \"%PLUGIN_ROOT%\\..\\room.py\" python \"%PLUGIN_ROOT%\\..\\room.py\" hook session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/../room.py", "hook", "prompt-submit"],
            "commandWindows": "if exist \"%PLUGIN_ROOT%\\..\\room.py\" python \"%PLUGIN_ROOT%\\..\\room.py\" hook prompt-submit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
